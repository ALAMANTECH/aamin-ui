  "files": [
    {
      "path": "src/components/app/NotificationBell.vue",
      "content": "<script lang=\"ts\">\nexport interface NotificationItem {\n  id: string;\n  title: string;\n  body?: string;\n  createdAt: string;\n  readAt: string | null;\n  /** Router path followed on click (after marking read). */\n  link?: string;\n  /** Drives the row icon + tint via the `eventIcons` / `eventTones` maps. */\n  event?: string;\n  /** Fallback icon key (`resourceIcons`) when the event has no icon. */\n  resource?: string;\n}\n\n/**\n * The bell's only link to a backend — the host maps its own endpoints here.\n * Every method may reject; the bell turns rejections into an inline error\n * (list) or a toast (mark read).\n */\nexport interface NotificationAdapter {\n  fetchCount(): Promise<number>;\n  fetchList(): Promise<NotificationItem[]>;\n  markRead(id: string): Promise<void>;\n  markAll(): Promise<void>;\n}\n</script>\n\n<script setup lang=\"ts\">\nimport { computed, inject, ref, watch, type Component } from \"vue\";\nimport { routerKey } from \"vue-router\";\nimport { toast } from \"vue-sonner\";\nimport { BellIcon } from \"@/lib/icons\";\nimport { Button } from \"@/components/ui/button\";\nimport { Popover, PopoverContent, PopoverTrigger } from \"@/components/ui/popover\";\nimport NotificationFeed from \"@/components/app/NotificationFeed.vue\";\nimport { usePoll } from \"@/composables/usePoll\";\nimport { i18n } from \"@/lib/i18n\";\n\n/**\n * The topbar bell. The unread count is fetched at mount and polled every\n * `pollMs` (stops after 3 consecutive failures, via usePoll); the list is\n * fetched when the popover opens. A row click marks it read and follows\n * `link` (through the router when one is installed); \"mark all\" clears the\n * badge. All data goes through the `adapter` prop — the bell knows no URLs.\n * Drop it into AppTopbar's `#notifications` slot.\n *\n * No Tooltip around the trigger: with TooltipTrigger and PopoverTrigger\n * nested (either order) reka never registers the popper anchor and the\n * content stays at its hidden offset. The aria-label carries the name.\n */\nconst props = withDefaults(\n  defineProps<{\n    adapter: NotificationAdapter;\n    /** Unread-count poll interval in ms (read once, at mount). */\n    pollMs?: number;\n    eventIcons?: Record<string, Component>;\n    eventTones?: Record<string, string>;\n    resourceIcons?: Record<string, Component>;\n    /** Events whose icon is directional and mirrors under RTL. */\n    flipEvents?: string[];\n  }>(),\n  {\n    pollMs: 60_000,\n    eventIcons: () => ({}),\n    eventTones: () => ({}),\n    resourceIcons: () => ({}),\n    flipEvents: () => [],\n  },\n);\n\nconst emit = defineEmits<{ open: [item: NotificationItem] }>();\n\nconst t = i18n.global.t;\nconst router = inject(routerKey, null);\n\nfunction errorText(err: unknown, fallback: string) {\n  return err instanceof Error && err.message ? err.message : fallback;\n}\n\nconst unread = ref(0);\n\nasync function refreshCount() {\n  const n = await props.adapter.fetchCount();\n  if (typeof n === \"number\" && Number.isFinite(n)) unread.value = Math.max(0, n);\n}\n\nvoid refreshCount().catch(() => {});\nusePoll(refreshCount, { interval: props.pollMs, maxFailures: 3 });\n\nconst open = ref(false);\nconst items = ref<NotificationItem[]>([]);\nconst loading = ref(false);\nconst error = ref(\"\");\n\nasync function loadList() {\n  loading.value = true;\n  try {\n    items.value = await props.adapter.fetchList();\n    error.value = \"\";\n  } catch (err) {\n    error.value = errorText(err, t(\"notifications.loadError\"));\n  } finally {\n    loading.value = false;\n  }\n}\n\nwatch(open, (isOpen) => {\n  if (!isOpen) return;\n  void loadList();\n  void refreshCount().catch(() => {});\n});\n\nasync function openRow(item: NotificationItem) {\n  emit(\"open\", item);\n  if (!item.readAt) {\n    // Optimistic: the row and badge update before the request settles.\n    item.readAt = new Date().toISOString();\n    unread.value = Math.max(0, unread.value - 1);\n    try {\n      await props.adapter.markRead(item.id);\n    } catch (err) {\n      toast.error(errorText(err, t(\"notifications.readFailed\")));\n    }\n  }\n  if (item.link) {\n    open.value = false;\n    if (router) void router.push(item.link);\n  }\n}\n\nasync function readAll() {\n  try {\n    await props.adapter.markAll();\n    const now = new Date().toISOString();\n    for (const n of items.value) if (!n.readAt) n.readAt = now;\n    unread.value = 0;\n  } catch (err) {\n    toast.error(errorText(err, t(\"notifications.readFailed\")));\n  }\n}\n\nconst badge = computed(() => (unread.value > 99 ? \"99+\" : String(unread.value)));\n</script>\n\n<template>\n  <Popover v-model:open=\"open\">\n    <PopoverTrigger as-child>\n      <Button\n        variant=\"ghost\"\n        size=\"icon\"\n        class=\"relative\"\n        :aria-label=\"t('notifications.bellLabel')\"\n      >\n        <BellIcon class=\"size-4\" aria-hidden=\"true\" />\n        <span\n          v-if=\"unread\"\n          class=\"absolute -end-0.5 -top-0.5 grid h-4 min-w-4 place-items-center rounded-full bg-destructive px-1 text-[10px] leading-none font-semibold text-primary-foreground ring-2 ring-background\"\n        >\n          <span class=\"num\">{{ badge }}</span>\n        </span>\n      </Button>\n    </PopoverTrigger>\n    <PopoverContent align=\"end\" class=\"w-[min(24rem,calc(100vw-2rem))] p-0\">\n      <NotificationFeed\n        :items=\"items\"\n        :unread-count=\"unread\"\n        :loading=\"loading\"\n        :error=\"error\"\n        :event-icons=\"eventIcons\"\n        :event-tones=\"eventTones\"\n        :resource-icons=\"resourceIcons\"\n        :flip-events=\"flipEvents\"\n        @open=\"openRow\"\n        @read-all=\"readAll\"\n        @retry=\"loadList\"\n      />\n    </PopoverContent>\n  </Popover>\n</template>\n",
      "type": "registry:component",
      "target": "~/src/components/app/NotificationBell.vue"
    },
    {
      "path": "src/components/app/NotificationFeed.vue",
      "content": "<script setup lang=\"ts\">\nimport { computed, ref, type Component } from \"vue\";\nimport { BellIcon, BellOffIcon, CheckCheckIcon } from \"@/lib/icons\";\nimport { Button } from \"@/components/ui/button\";\nimport { ScrollArea } from \"@/components/ui/scroll-area\";\nimport { Skeleton } from \"@/components/ui/skeleton\";\nimport { Tabs, TabsList, TabsTrigger } from \"@/components/ui/tabs\";\nimport EmptyState from \"@/components/app/EmptyState.vue\";\nimport type { NotificationItem } from \"@/components/app/NotificationBell.vue\";\nimport { formatTimeAgo } from \"@/lib/datetime\";\nimport { i18n } from \"@/lib/i18n\";\n\n/**\n * The notification list inside NotificationBell's popover (usable on its own,\n * e.g. a full-page inbox): header with the unread count and \"mark all read\",\n * an unread/all switch, then the rows — an icon by `event` (falling back to\n * `resource`, then a bell), a tint by `event`, the title + body, and the time\n * ago. The host owns the data and the side effects (`open` marks read and\n * navigates, `readAll` marks everything read).\n */\nconst props = withDefaults(\n  defineProps<{\n    items: NotificationItem[];\n    unreadCount: number;\n    loading?: boolean;\n    error?: string;\n    /** Icon per `event` — wins over `resourceIcons`. */\n    eventIcons?: Record<string, Component>;\n    /** Token tint classes per `event`, e.g. `\"bg-primary/15 text-primary\"`. */\n    eventTones?: Record<string, string>;\n    /** Icon per `resource` when the event has none. */\n    resourceIcons?: Record<string, Component>;\n    /** Events whose icon is directional (arrows) and mirrors under RTL. */\n    flipEvents?: string[];\n  }>(),\n  {\n    loading: false,\n    error: \"\",\n    eventIcons: () => ({}),\n    eventTones: () => ({}),\n    resourceIcons: () => ({}),\n    flipEvents: () => [],\n  },\n);\n\nconst emit = defineEmits<{ open: [item: NotificationItem]; readAll: []; retry: [] }>();\n\nconst t = i18n.global.t;\n\nconst tab = ref<\"unread\" | \"all\">(\"unread\");\nconst visible = computed(() =>\n  tab.value === \"unread\" ? props.items.filter((n) => !n.readAt) : props.items,\n);\n\nfunction icon(n: NotificationItem): Component {\n  return (\n    (n.event && props.eventIcons[n.event]) ||\n    (n.resource && props.resourceIcons[n.resource]) ||\n    BellIcon\n  );\n}\nfunction tone(n: NotificationItem) {\n  return (n.event && props.eventTones[n.event]) || \"bg-muted text-muted-foreground\";\n}\nfunction flips(n: NotificationItem) {\n  return Boolean(n.event && props.flipEvents.includes(n.event));\n}\n</script>\n\n<template>\n  <div class=\"flex min-h-0 flex-col\">\n    <div class=\"flex items-center gap-2 border-b border-border px-3 py-2.5\">\n      <p class=\"text-sm font-semibold\">\n        {{ t(\"notifications.title\") }}\n        <span\n          v-if=\"unreadCount\"\n          class=\"ms-1 rounded-full bg-primary/10 px-1.5 py-0.5 text-[11px] font-medium text-primary\"\n        >\n          <span class=\"num\">{{ unreadCount }}</span>\n        </span>\n      </p>\n      <Button\n        variant=\"ghost\"\n        size=\"xs\"\n        class=\"ms-auto text-muted-foreground\"\n        :disabled=\"!unreadCount\"\n        @click=\"emit('readAll')\"\n      >\n        <CheckCheckIcon class=\"size-3.5\" aria-hidden=\"true\" />\n        {{ t(\"notifications.markAll\") }}\n      </Button>\n    </div>\n\n    <div class=\"px-3 pt-2\">\n      <Tabs v-model=\"tab\">\n        <TabsList variant=\"line\" class=\"h-8\">\n          <TabsTrigger value=\"unread\" class=\"text-xs\">\n            {{ t(\"notifications.tabUnread\") }}\n            <span v-if=\"unreadCount\" class=\"num ms-1 text-[10px] text-muted-foreground\">{{\n              unreadCount\n            }}</span>\n          </TabsTrigger>\n          <TabsTrigger value=\"all\" class=\"text-xs\">{{ t(\"notifications.tabAll\") }}</TabsTrigger>\n        </TabsList>\n      </Tabs>\n    </div>\n\n    <ScrollArea class=\"max-h-80\">\n      <div v-if=\"loading && !items.length\" class=\"space-y-3 p-3\">\n        <div v-for=\"n in 3\" :key=\"n\" class=\"flex gap-3\">\n          <Skeleton class=\"size-8 shrink-0 rounded-lg\" />\n          <div class=\"flex-1 space-y-1.5\">\n            <Skeleton class=\"h-3.5 w-3/4\" />\n            <Skeleton class=\"h-3 w-1/2\" />\n          </div>\n        </div>\n      </div>\n\n      <EmptyState\n        v-else-if=\"error && !items.length\"\n        bare\n        state=\"error\"\n        :title=\"t('notifications.loadError')\"\n        :error-message=\"error\"\n        @retry=\"emit('retry')\"\n      />\n\n      <div\n        v-else-if=\"!visible.length\"\n        class=\"flex flex-col items-center gap-2 px-4 py-10 text-center\"\n      >\n        <span class=\"grid size-10 place-items-center rounded-full bg-muted text-muted-foreground\">\n          <BellOffIcon class=\"size-4\" aria-hidden=\"true\" />\n        </span>\n        <p class=\"text-sm font-medium\">{{ t(\"notifications.empty\") }}</p>\n        <p class=\"text-xs text-muted-foreground\">{{ t(\"notifications.emptyHint\") }}</p>\n      </div>\n\n      <ul v-else class=\"divide-y divide-border/70\">\n        <li v-for=\"n in visible\" :key=\"n.id\">\n          <button\n            type=\"button\"\n            class=\"flex w-full items-start gap-3 px-3 py-2.5 text-start transition-colors hover:bg-muted/50\"\n            :class=\"n.readAt ? '' : 'bg-primary/5'\"\n            @click=\"emit('open', n)\"\n          >\n            <span\n              class=\"relative mt-0.5 grid size-8 shrink-0 place-items-center rounded-lg\"\n              :class=\"tone(n)\"\n            >\n              <component\n                :is=\"icon(n)\"\n                class=\"size-4\"\n                :class=\"flips(n) ? 'cn-rtl-flip' : ''\"\n                aria-hidden=\"true\"\n              />\n              <span\n                v-if=\"!n.readAt\"\n                class=\"absolute -start-0.5 -top-0.5 size-2 rounded-full bg-primary ring-2 ring-popover\"\n                aria-hidden=\"true\"\n              />\n            </span>\n            <span class=\"min-w-0 flex-1\">\n              <span\n                class=\"block text-sm leading-snug\"\n                :class=\"n.readAt ? 'font-normal' : 'font-semibold'\"\n              >\n                {{ n.title }}\n              </span>\n              <span\n                v-if=\"n.body\"\n                class=\"mt-0.5 line-clamp-2 block text-xs leading-relaxed text-muted-foreground\"\n              >\n                {{ n.body }}\n              </span>\n              <span class=\"mt-1 block text-[11px] text-muted-foreground\">\n                {{ formatTimeAgo(n.createdAt, `${i18n.global.locale.value}-u-nu-latn`) }}\n              </span>\n            </span>\n          </button>\n        </li>\n      </ul>\n    </ScrollArea>\n  </div>\n</template>\n",
      "type": "registry:component",
      "target": "~/src/components/app/NotificationFeed.vue"
    }
  ],
  "type": "registry:component"
}
