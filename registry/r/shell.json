  "files": [
    {
      "path": "src/components/app/AppSidebar.vue",
      "content": "<script setup lang=\"ts\">\nimport { computed } from \"vue\";\nimport { useRoute } from \"vue-router\";\nimport { ShieldCheckIcon } from \"@/lib/icons\";\nimport { Badge } from \"@/components/ui/badge\";\nimport { ScrollArea } from \"@/components/ui/scroll-area\";\nimport { navGroups } from \"@/lib/nav\";\nimport { i18n } from \"@/lib/i18n\";\n\nconst t = i18n.global.t;\n\ndefineProps<{\n  /** Icon-rail mode (desktop collapse). */\n  collapsed?: boolean;\n}>();\n\nconst route = useRoute();\n\n// A link is active only when its `to` is the LONGEST nav path matching the\n// current route — otherwise \"/reference\" and \"/reference/components\" would\n// both light up. Detail routes (\"/tables/123\") still fall back to their parent\n// list link, and matching is segment-aware so \"/tables\" never matches \"/tablesx\".\nconst activeTo = computed(() => {\n  const path = route.path;\n  let best = \"\";\n  for (const group of navGroups) {\n    for (const item of group.items) {\n      const matches =\n        item.to === \"/\" ? path === \"/\" : path === item.to || path.startsWith(item.to + \"/\");\n      if (matches && item.to.length > best.length) best = item.to;\n    }\n  }\n  return best;\n});\n\nconst isActive = (to: string) => to === activeTo.value;\n</script>\n\n<template>\n  <div class=\"flex h-full flex-col bg-sidebar text-sidebar-foreground\">\n    <!-- Wordmark -->\n    <div\n      class=\"flex h-16 shrink-0 items-center gap-2.5 px-5\"\n      :class=\"{ 'justify-center px-0': collapsed }\"\n    >\n      <span\n        class=\"grid size-8 shrink-0 place-items-center rounded-lg bg-primary/15 text-primary glow-primary\"\n      >\n        <ShieldCheckIcon class=\"size-4.5\" />\n      </span>\n      <div v-if=\"!collapsed\" class=\"leading-tight\">\n        <p class=\"text-sm font-semibold text-sidebar-accent-foreground\">{{ t(\"app.name\") }}</p>\n        <p class=\"text-[11px] text-muted-foreground\">{{ t(\"app.title\") }}</p>\n      </div>\n    </div>\n\n    <!-- Nav -->\n    <ScrollArea class=\"min-h-0 flex-1 px-3\">\n      <nav :aria-label=\"t('sidebar.mainNavAria')\" class=\"flex flex-col gap-5 pb-6 pt-2\">\n        <div v-for=\"group in navGroups\" :key=\"group.label\">\n          <p\n            v-if=\"!collapsed\"\n            class=\"mb-1.5 px-3 text-[11px] font-semibold text-muted-foreground/70\"\n          >\n            {{ t(group.label) }}\n          </p>\n          <ul class=\"flex flex-col gap-0.5\">\n            <li v-for=\"item in group.items\" :key=\"item.to\">\n              <RouterLink\n                :to=\"item.to\"\n                class=\"group relative flex h-9 items-center gap-2.5 rounded-lg px-3 text-[13px] font-medium transition-colors\"\n                :class=\"[\n                  isActive(item.to)\n                    ? 'bg-primary/10 text-primary dark:bg-primary/15'\n                    : 'text-sidebar-foreground hover:bg-sidebar-accent/60 hover:text-sidebar-accent-foreground',\n                  collapsed && 'justify-center px-0',\n                ]\"\n                :aria-current=\"isActive(item.to) ? 'page' : undefined\"\n                :title=\"collapsed ? t(item.title) : undefined\"\n              >\n                <!-- Glowing active indicator on the start edge -->\n                <span\n                  v-if=\"isActive(item.to)\"\n                  class=\"absolute inset-y-2 start-0 w-0.5 rounded-full bg-primary glow-primary\"\n                  aria-hidden=\"true\"\n                />\n                <component\n                  :is=\"item.icon\"\n                  class=\"size-4 shrink-0 transition-colors\"\n                  :class=\"\n                    isActive(item.to)\n                      ? 'text-primary'\n                      : 'text-muted-foreground group-hover:text-sidebar-accent-foreground'\n                  \"\n                />\n                <template v-if=\"!collapsed\">\n                  <span class=\"truncate\">{{ t(item.title) }}</span>\n                  <Badge\n                    v-if=\"item.badge\"\n                    variant=\"secondary\"\n                    class=\"num ms-auto h-5 px-1.5 text-[10px]\"\n                  >\n                    {{ item.badge }}\n                  </Badge>\n                </template>\n              </RouterLink>\n            </li>\n          </ul>\n        </div>\n      </nav>\n    </ScrollArea>\n\n    <!-- Footer / user. Point `to` at your profile page once you build one\n         (recipe: src/pages/reference/ProfilePage.vue). -->\n    <div class=\"shrink-0 border-t border-sidebar-border p-3\">\n      <RouterLink\n        to=\"/\"\n        class=\"flex items-center gap-2.5 rounded-lg p-2 transition-colors hover:bg-sidebar-accent/60\"\n        :class=\"{ 'justify-center': collapsed }\"\n      >\n        <span\n          class=\"grid size-8 shrink-0 place-items-center rounded-full bg-primary/15 text-xs font-semibold text-primary\"\n        >\n          {{ t(\"shell.user.initials\") }}\n        </span>\n        <div v-if=\"!collapsed\" class=\"min-w-0 leading-tight\">\n          <p class=\"truncate text-[13px] font-medium text-sidebar-accent-foreground\">\n            {{ t(\"shell.user.name\") }}\n          </p>\n          <p class=\"truncate text-[11px] text-muted-foreground\">{{ t(\"shell.user.role\") }}</p>\n        </div>\n      </RouterLink>\n    </div>\n  </div>\n</template>\n",
      "type": "registry:component",
      "target": "~/src/components/app/AppSidebar.vue"
    },
    {
      "path": "src/components/app/AppTopbar.vue",
      "content": "<script setup lang=\"ts\">\nimport { computed } from \"vue\";\nimport { useRoute, useRouter } from \"vue-router\";\nimport { LogOutIcon, MenuIcon, PanelRightIcon, UserRoundIcon } from \"@/lib/icons\";\nimport { Button } from \"@/components/ui/button\";\nimport {\n  Breadcrumb,\n  BreadcrumbItem,\n  BreadcrumbLink,\n  BreadcrumbList,\n  BreadcrumbPage,\n  BreadcrumbSeparator,\n} from \"@/components/ui/breadcrumb\";\nimport {\n  DropdownMenu,\n  DropdownMenuContent,\n  DropdownMenuItem,\n  DropdownMenuLabel,\n  DropdownMenuSeparator,\n  DropdownMenuTrigger,\n} from \"@/components/ui/dropdown-menu\";\nimport { Tooltip, TooltipContent, TooltipTrigger } from \"@/components/ui/tooltip\";\nimport CommandMenu from \"./CommandMenu.vue\";\nimport ThemeToggle from \"./ThemeToggle.vue\";\nimport LocaleToggle from \"./LocaleToggle.vue\";\nimport { i18n } from \"@/lib/i18n\";\n\nconst t = i18n.global.t;\n\ndefineProps<{\n  /** `lg` and up: the sidebar is a persistent rail, so the button collapses it. Below: it opens the drawer. */\n  isDesktop?: boolean;\n}>();\n\ndefineEmits<{ (e: \"toggle-sidebar\"): void }>();\n\nconst route = useRoute();\nconst router = useRouter();\n\nconst pageTitle = computed(() => (route.meta.titleKey ? t(route.meta.titleKey) : undefined));\n</script>\n\n<template>\n  <header\n    class=\"sticky top-0 z-30 flex h-[calc(4rem+env(safe-area-inset-top))] shrink-0 items-center gap-2 border-b bg-background/80 ps-1 pe-3 pt-[env(safe-area-inset-top)] backdrop-blur-md sm:gap-3 sm:ps-2 sm:pe-4 md:ps-6 md:pe-8\"\n  >\n    <Tooltip>\n      <TooltipTrigger as-child>\n        <Button\n          variant=\"ghost\"\n          size=\"icon\"\n          class=\"shrink-0\"\n          :aria-label=\"isDesktop ? t('topbar.toggleSidebar') : t('topbar.openMenu')\"\n          @click=\"$emit('toggle-sidebar')\"\n        >\n          <PanelRightIcon v-if=\"isDesktop\" class=\"size-4 ltr:-scale-x-100\" />\n          <MenuIcon v-else class=\"size-5\" />\n        </Button>\n      </TooltipTrigger>\n      <TooltipContent>{{ isDesktop ? t(\"topbar.sidebar\") : t(\"topbar.menu\") }}</TooltipContent>\n    </Tooltip>\n\n    <!-- Phone / tablet: the page title; breadcrumbs take over from lg. -->\n    <p v-if=\"pageTitle\" class=\"min-w-0 flex-1 truncate text-sm font-medium lg:hidden\">\n      {{ pageTitle }}\n    </p>\n\n    <Breadcrumb class=\"hidden min-w-0 lg:flex\">\n      <BreadcrumbList>\n        <BreadcrumbItem>\n          <BreadcrumbLink as-child>\n            <RouterLink to=\"/\">{{ t(\"nav.home\") }}</RouterLink>\n          </BreadcrumbLink>\n        </BreadcrumbItem>\n        <template v-if=\"route.path !== '/' && pageTitle\">\n          <BreadcrumbSeparator />\n          <BreadcrumbItem>\n            <BreadcrumbPage>{{ pageTitle }}</BreadcrumbPage>\n          </BreadcrumbItem>\n        </template>\n      </BreadcrumbList>\n    </Breadcrumb>\n\n    <!-- End cluster — fixed order in every project (don't fork, don't move):\n         [notifications slot] · LocaleToggle · ThemeToggle · user menu -->\n    <div class=\"ms-auto flex shrink-0 items-center gap-0.5 sm:gap-1.5\">\n      <CommandMenu />\n\n      <div v-if=\"$slots.notifications\" data-shell-slot=\"notifications\" class=\"flex items-center\">\n        <slot name=\"notifications\" />\n      </div>\n      <div data-shell-slot=\"locale\" class=\"flex items-center\"><LocaleToggle /></div>\n      <div data-shell-slot=\"theme\" class=\"flex items-center\"><ThemeToggle /></div>\n\n      <div data-shell-slot=\"user\" class=\"flex items-center\">\n        <DropdownMenu>\n          <DropdownMenuTrigger as-child>\n            <button\n              class=\"ms-1 grid size-8 place-items-center rounded-full bg-primary/15 text-xs font-semibold text-primary transition-transform hover:scale-105 focus-visible:outline-2 focus-visible:outline-ring\"\n              :aria-label=\"t('topbar.userMenu')\"\n            >\n              {{ t(\"shell.user.initials\") }}\n            </button>\n          </DropdownMenuTrigger>\n          <DropdownMenuContent align=\"end\" class=\"w-52\">\n            <DropdownMenuLabel>\n              <p class=\"text-sm font-medium\">{{ t(\"shell.user.name\") }}</p>\n              <p class=\"text-xs font-normal text-muted-foreground\">{{ t(\"shell.user.email\") }}</p>\n            </DropdownMenuLabel>\n            <DropdownMenuSeparator />\n            <DropdownMenuItem @select=\"router.push('/profile')\">\n              <UserRoundIcon class=\"size-4\" />\n              {{ t(\"nav.profile\") }}\n            </DropdownMenuItem>\n            <DropdownMenuSeparator />\n            <DropdownMenuItem variant=\"destructive\" @select=\"router.push('/login')\">\n              <LogOutIcon class=\"size-4\" />\n              {{ t(\"auth.logout\") }}\n            </DropdownMenuItem>\n          </DropdownMenuContent>\n        </DropdownMenu>\n      </div>\n    </div>\n  </header>\n</template>\n",
      "type": "registry:component",
      "target": "~/src/components/app/AppTopbar.vue"
    },
    {
      "path": "src/components/app/CommandMenu.vue",
      "content": "<script setup lang=\"ts\">\nimport { ref } from \"vue\";\nimport { useRouter } from \"vue-router\";\nimport { useMagicKeys, whenever } from \"@vueuse/core\";\nimport { MoonStarIcon, SearchIcon } from \"@/lib/icons\";\nimport {\n  CommandDialog,\n  CommandEmpty,\n  CommandGroup,\n  CommandInput,\n  CommandItem,\n  CommandList,\n  CommandSeparator,\n} from \"@/components/ui/command\";\nimport { Button } from \"@/components/ui/button\";\nimport { navGroups } from \"@/lib/nav\";\nimport { useTheme } from \"@/composables/useTheme\";\nimport Kbd from \"@/components/app/Kbd.vue\";\nimport { i18n } from \"@/lib/i18n\";\n\nconst t = i18n.global.t;\n\nconst open = ref(false);\nconst router = useRouter();\nconst { toggle: toggleTheme } = useTheme();\n\n// passive: false + preventDefault so ⌘K/Ctrl+K opens the palette instead of\n// the browser's address/search bar (Firefox + Chromium-on-Windows bind Ctrl+K).\nconst keys = useMagicKeys({\n  passive: false,\n  onEventFired(e) {\n    if (e.key.toLowerCase() === \"k\" && (e.metaKey || e.ctrlKey) && e.type === \"keydown\")\n      e.preventDefault();\n  },\n});\nwhenever(keys[\"Meta+K\"]!, () => (open.value = true));\nwhenever(keys[\"Ctrl+K\"]!, () => (open.value = true));\n\nfunction go(to: string) {\n  open.value = false;\n  router.push(to);\n}\n</script>\n\n<template>\n  <Button\n    variant=\"outline\"\n    class=\"h-9 w-56 justify-between gap-2 text-muted-foreground font-normal max-md:hidden\"\n    @click=\"open = true\"\n  >\n    <span class=\"flex items-center gap-2\">\n      <SearchIcon class=\"size-4\" />\n      {{ t(\"command.quickSearch\") }}\n    </span>\n    <Kbd>⌘K</Kbd>\n  </Button>\n  <Button\n    variant=\"ghost\"\n    size=\"icon\"\n    class=\"md:hidden\"\n    :aria-label=\"t('command.quickSearchAria')\"\n    @click=\"open = true\"\n  >\n    <SearchIcon class=\"size-4\" />\n  </Button>\n\n  <CommandDialog v-model:open=\"open\">\n    <CommandInput :placeholder=\"t('command.placeholder')\" />\n    <CommandList>\n      <CommandEmpty>{{ t(\"command.empty\") }}</CommandEmpty>\n      <CommandGroup v-for=\"group in navGroups\" :key=\"group.label\" :heading=\"t(group.label)\">\n        <CommandItem\n          v-for=\"item in group.items\"\n          :key=\"item.to\"\n          :value=\"t(item.title)\"\n          @select=\"go(item.to)\"\n        >\n          <component :is=\"item.icon\" class=\"size-4\" />\n          {{ t(item.title) }}\n        </CommandItem>\n      </CommandGroup>\n      <CommandSeparator />\n      <CommandGroup :heading=\"t('command.commands')\">\n        <CommandItem\n          :value=\"t('command.toggleTheme')\"\n          @select=\"\n            () => {\n              toggleTheme();\n              open = false;\n            }\n          \"\n        >\n          <MoonStarIcon class=\"size-4\" />\n          {{ t(\"command.toggleTheme\") }}\n        </CommandItem>\n      </CommandGroup>\n    </CommandList>\n  </CommandDialog>\n</template>\n",
      "type": "registry:component",
      "target": "~/src/components/app/CommandMenu.vue"
    },
    {
      "path": "src/components/app/LocaleToggle.vue",
      "content": "<script setup lang=\"ts\">\nimport { computed } from \"vue\";\nimport { LanguagesIcon } from \"@/lib/icons\";\nimport { Button } from \"@/components/ui/button\";\nimport {\n  DropdownMenu,\n  DropdownMenuContent,\n  DropdownMenuRadioGroup,\n  DropdownMenuRadioItem,\n  DropdownMenuTrigger,\n} from \"@/components/ui/dropdown-menu\";\nimport { Tooltip, TooltipContent, TooltipTrigger } from \"@/components/ui/tooltip\";\nimport { useLocale } from \"@/composables/useLocale\";\nimport { i18n } from \"@/lib/i18n\";\n\nconst t = i18n.global.t;\nconst { locale, locales, set, toggle } = useLocale();\n\n// With two locales the button just flips; its tooltip names the language\n// you'd switch TO. Labels are each language's own name — never translated.\nconst other = computed(() => locales.find((l) => l.code !== locale.value) ?? locales[0]!);\n\nfunction onSelect(code: unknown) {\n  if (typeof code === \"string\") set(code);\n}\n</script>\n\n<template>\n  <Tooltip v-if=\"locales.length === 2\">\n    <TooltipTrigger as-child>\n      <Button variant=\"ghost\" size=\"icon\" :aria-label=\"t('language.toggle')\" @click=\"toggle\">\n        <LanguagesIcon class=\"size-4\" />\n      </Button>\n    </TooltipTrigger>\n    <TooltipContent :lang=\"other.code\">{{ other.label }}</TooltipContent>\n  </Tooltip>\n\n  <!-- 3+ locales: a menu. No Tooltip around the trigger (nested reka triggers misbehave).\n       A single-language app renders nothing — there is nowhere to switch to. -->\n  <DropdownMenu v-else-if=\"locales.length > 2\">\n    <DropdownMenuTrigger as-child>\n      <Button variant=\"ghost\" size=\"icon\" :aria-label=\"t('language.toggle')\">\n        <LanguagesIcon class=\"size-4\" />\n      </Button>\n    </DropdownMenuTrigger>\n    <DropdownMenuContent align=\"end\">\n      <DropdownMenuRadioGroup :model-value=\"locale\" @update:model-value=\"onSelect\">\n        <DropdownMenuRadioItem v-for=\"l in locales\" :key=\"l.code\" :value=\"l.code\" :lang=\"l.code\">\n          {{ l.label }}\n        </DropdownMenuRadioItem>\n      </DropdownMenuRadioGroup>\n    </DropdownMenuContent>\n  </DropdownMenu>\n</template>\n",
      "type": "registry:component",
      "target": "~/src/components/app/LocaleToggle.vue"
    },
    {
      "path": "src/components/app/ThemeToggle.vue",
      "content": "<script setup lang=\"ts\">\nimport { MoonStarIcon, SunIcon } from \"@/lib/icons\";\nimport { Button } from \"@/components/ui/button\";\nimport { Tooltip, TooltipContent, TooltipTrigger } from \"@/components/ui/tooltip\";\nimport { useTheme } from \"@/composables/useTheme\";\nimport { i18n } from \"@/lib/i18n\";\n\nconst t = i18n.global.t;\n\nconst { mode, toggle } = useTheme();\n</script>\n\n<template>\n  <Tooltip>\n    <TooltipTrigger as-child>\n      <Button variant=\"ghost\" size=\"icon\" :aria-label=\"t('theme.toggle')\" @click=\"toggle\">\n        <SunIcon v-if=\"mode === 'dark'\" class=\"size-4\" />\n        <MoonStarIcon v-else class=\"size-4\" />\n      </Button>\n    </TooltipTrigger>\n    <TooltipContent>{{ mode === \"dark\" ? t(\"theme.light\") : t(\"theme.dark\") }}</TooltipContent>\n  </Tooltip>\n</template>\n",
      "type": "registry:component",
      "target": "~/src/components/app/ThemeToggle.vue"
    },
    {
      "path": "src/layouts/BlankLayout.vue",
      "content": "<script setup lang=\"ts\">\nimport { RouterView } from \"vue-router\";\nimport ThemeToggle from \"@/components/app/ThemeToggle.vue\";\nimport LocaleToggle from \"@/components/app/LocaleToggle.vue\";\n</script>\n\n<template>\n  <!-- Layout for full-screen pages (login, 404) rendered without the dashboard\n       shell. Standard placement, same in every project: the top-end corner\n       holds LocaleToggle · ThemeToggle — don't move it, don't re-add the\n       toggles inside the page itself. -->\n  <div class=\"relative min-h-dvh\">\n    <div\n      class=\"absolute end-4 top-[max(1rem,env(safe-area-inset-top))] z-20 flex items-center gap-1\"\n    >\n      <div data-shell-slot=\"locale\"><LocaleToggle /></div>\n      <div data-shell-slot=\"theme\"><ThemeToggle /></div>\n    </div>\n\n    <RouterView />\n  </div>\n</template>\n",
      "type": "registry:component",
      "target": "~/src/layouts/BlankLayout.vue"
    },
    {
      "path": "src/layouts/DashboardLayout.vue",
      "content": "<script setup lang=\"ts\">\nimport { nextTick, onBeforeUnmount, ref } from \"vue\";\nimport { RouterView, useRouter } from \"vue-router\";\nimport { useBreakpoints, useStorage } from \"@vueuse/core\";\nimport { Sheet, SheetContent } from \"@/components/ui/sheet\";\nimport AppSidebar from \"@/components/app/AppSidebar.vue\";\nimport AppTopbar from \"@/components/app/AppTopbar.vue\";\nimport { useDir } from \"@/composables/useDir\";\n\nconst { dir } = useDir();\nconst breakpoints = useBreakpoints({ lg: 1024 });\nconst isDesktop = breakpoints.greaterOrEqual(\"lg\");\n\nconst collapsed = useStorage(\"aamin-ui-sidebar-collapsed\", false);\nconst mobileOpen = ref(false);\n\n// Real scroll reset: the document never scrolls (root is h-dvh/overflow-hidden),\n// so <main> is the only scroll container and vue-router's scrollBehavior (which\n// targets window) can't reset it. Reset the container after each navigation\n// resolves. `nextTick` lets the route render settle first; the swap runs under\n// <Transition mode=\"out-in\"> so the new page enters at the top. In-page hash\n// jumps are handled by scrollBehavior's `el` case in router.ts and skipped here\n// (same route path => no reset).\nconst scroller = ref<HTMLElement | null>(null);\nconst router = useRouter();\n\nconst stopAfterEach = router.afterEach((to, from) => {\n  if (to.path === from.path) return;\n  nextTick(() => scroller.value?.scrollTo({ top: 0 }));\n});\nonBeforeUnmount(stopAfterEach);\n\nfunction toggleSidebar() {\n  if (isDesktop.value) {\n    collapsed.value = !collapsed.value;\n  } else {\n    mobileOpen.value = !mobileOpen.value;\n  }\n}\n</script>\n\n<template>\n  <div class=\"flex h-dvh overflow-hidden\">\n    <!-- Desktop sidebar -->\n    <aside\n      v-if=\"isDesktop\"\n      class=\"shrink-0 border-e border-sidebar-border transition-[width] duration-200\"\n      :class=\"collapsed ? 'w-[68px]' : 'w-64'\"\n    >\n      <AppSidebar :collapsed=\"collapsed\" />\n    </aside>\n\n    <!-- Mobile drawer -->\n    <Sheet v-else v-model:open=\"mobileOpen\">\n      <!-- The drawer enters from the sidebar's side: start of the reading direction -->\n      <SheetContent\n        :side=\"dir === 'rtl' ? 'right' : 'left'\"\n        class=\"w-72 max-w-[85vw] p-0\"\n        aria-describedby=\"\"\n      >\n        <AppSidebar @click=\"mobileOpen = false\" />\n      </SheetContent>\n    </Sheet>\n\n    <!-- Content column -->\n    <div class=\"flex min-w-0 flex-1 flex-col overflow-hidden\">\n      <!-- A product's notification bell goes in AppTopbar's #notifications slot:\n           <AppTopbar …><template #notifications><YourBell /></template></AppTopbar> -->\n      <AppTopbar :is-desktop=\"isDesktop\" @toggle-sidebar=\"toggleSidebar\" />\n      <!-- relative: <main> must be the containing block of everything inside\n           it. An absolutely-positioned descendant with no positioned ancestor\n           (an sr-only input) is laid out against the document instead, escapes\n           this scroller's clipping and makes the PAGE scroll too.\n           stable both-edges: classic (non-overlay) scrollbars reserve equal\n           space on BOTH sides, so the content column stays centered under the\n           full-width topbar instead of shifting away from the scrollbar side.\n           Phone gutter is px-3 — DataTable's phone full-bleed (-mx-3) relies on it. -->\n      <main\n        ref=\"scroller\"\n        class=\"relative min-h-0 flex-1 overflow-x-hidden overflow-y-auto bg-halo [scrollbar-gutter:stable_both-edges]\"\n      >\n        <div\n          class=\"mx-auto w-full min-w-0 max-w-7xl px-3 py-4 pb-[max(1rem,env(safe-area-inset-bottom))] sm:px-4 sm:py-6 sm:pb-[max(1.5rem,env(safe-area-inset-bottom))] md:px-8 md:py-8 md:pb-[max(2rem,env(safe-area-inset-bottom))]\"\n        >\n          <RouterView v-slot=\"{ Component }\">\n            <Transition name=\"page\" mode=\"out-in\">\n              <component :is=\"Component\" />\n            </Transition>\n          </RouterView>\n        </div>\n      </main>\n    </div>\n  </div>\n</template>\n\n<style scoped>\n.page-enter-active,\n.page-leave-active {\n  transition:\n    opacity 0.15s ease,\n    transform 0.15s ease;\n}\n.page-enter-from {\n  opacity: 0;\n  transform: translateY(6px);\n}\n.page-leave-to {\n  opacity: 0;\n}\n</style>\n",
      "type": "registry:component",
      "target": "~/src/layouts/DashboardLayout.vue"
    },
